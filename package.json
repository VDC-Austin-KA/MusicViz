{
  "name": "musicviz",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "description": "MusicViz — next-gen immersive music-reactive platform. Vite + TypeScript + Three/WebGPU + WebXR 6DOF",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node server.js",
    "postinstall": "node scripts/ensure-soloist.js || true",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.162.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "@types/three": "^0.162.0"
  }
}
